{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicdata.tech/schemas/governed_geometry_snapshot_v0.1.schema.json",
  "title": "CivicData Governed Geometry Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "snapshot_id",
    "generated_at",
    "jurisdiction_ocdid",
    "source",
    "division_property",
    "expected_division_ids",
    "feature_collection"
  ],
  "properties": {
    "snapshot_version": {
      "const": "0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction_ocdid": {
      "type": "string",
      "pattern": "^ocd-jurisdiction/"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "locator",
        "retrieved_at",
        "source_snapshot_id",
        "derivation"
      ],
      "properties": {
        "authority": {
          "enum": [
            "PRIMARY_OFFICIAL",
            "SECONDARY_OFFICIAL",
            "OTHER"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "derivation": {
          "enum": [
            "DIRECT_MACHINE_SOURCE",
            "OFFICIAL_EXPORT"
          ]
        }
      }
    },
    "division_property": {
      "type": "string",
      "minLength": 1
    },
    "expected_division_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ocd-division/"
      }
    },
    "feature_collection": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "geometry"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "properties": {
                "type": "object"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
