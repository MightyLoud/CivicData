{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicdata.tech/schemas/interoperable_snapshot_manifest_v0.1.schema.json",
  "title": "CivicData Interoperable Snapshot Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "schema_version",
    "generated_at",
    "producer",
    "source_snapshots",
    "scope",
    "certification",
    "canonical_data_versions",
    "payload",
    "manifest_sha256"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.1"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "adapter_version"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "snapshot_id",
          "locator"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction_ocdid",
        "division_ocdids",
        "complete_jurisdiction"
      ],
      "properties": {
        "jurisdiction_ocdid": {
          "type": "string",
          "pattern": "^ocd-jurisdiction/"
        },
        "division_ocdids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ocd-division/"
          }
        },
        "complete_jurisdiction": {
          "type": "boolean"
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "raw_complete",
        "normalized_complete",
        "qa_passed",
        "parity_ok",
        "verified_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "uncertified",
            "evidence_review",
            "external_blocker",
            "rule_fix",
            "certified"
          ]
        },
        "raw_complete": {
          "type": "boolean"
        },
        "normalized_complete": {
          "type": "boolean"
        },
        "qa_passed": {
          "type": "boolean"
        },
        "parity_ok": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "canonical_data_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "locator",
        "bytes",
        "content_sha256"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
